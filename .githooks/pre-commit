#!/usr/bin/env bash
# The fast half of the gate, enforced. Across the four audited projects, nothing mechanically blocked
# a commit and every quality gate was honour-system; CI caught things only after the fact.
#
# Typecheck only. Android Lint takes tens of seconds even warm, so it stays in the gate and CI with
# the tests, and there is no formatter yet (see DECISIONS.md). A slow hook teaches `--no-verify`.
#
# Enable once per clone (SETUP.md step): git config core.hooksPath .githooks

set -e

echo "pre-commit: typecheck"
./gradlew --quiet compileDebugKotlin compileDebugUnitTestKotlin

echo "pre-commit: ok (lint and tests run in \`./gradlew test assembleDebug lintDebug\` and in CI)"
