<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textSize="22sp" />

    <Button
        android:id="@+id/unlockButton"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="@string/unlock_ask"
        android:visibility="gone" />

    <TextView
        android:id="@+id/unlockStatus"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:visibility="gone" />

    <Button
        android:id="@+id/usePinButton"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/unlock_use_pin"
        android:visibility="gone" />

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:hint="@string/pin_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/pinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minHeight="24dp"
        android:textColor="@color/error" />

    <Button
        android:id="@+id/pinSubmit"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pin_submit" />

    <Button
        android:id="@+id/parentPhoneButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/parent_phone_button"
        android:visibility="gone" />
</LinearLayout>
